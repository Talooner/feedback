test "do-not-merge label blocks the merge, other labels do not" {
  given {
    record 1 type "pr"
    attr 1 "pr.labels" ["do-not-merge", "backend"]

    record 2 type "pr"
    attr 2 "pr.labels" ["backend"]

    record 3 type "pr"
    attr 3 "pr.labels" []
  }

  when rule "Block do-not-merge PRs"

  expect {
    flagged 1
    not flagged 2
    not flagged 3
    did 1 block "pr.merge"
    did_not 2 block "pr.merge"
    did_not 3 block "pr.merge"
  }
}

test "Label match is a substring scan, so a longer label also matches" {
  given {
    record 1 type "pr"
    attr 1 "pr.labels" ["do-not-merge-yet"]
  }

  when rule "Block do-not-merge PRs"

  expect {
    flagged 1
  }
}

test "Failing tests block, passing and unknown do not" {
  given {
    record 1 type "pr"
    attr 1 "pr.tests_passing" false

    record 2 type "pr"
    attr 2 "pr.tests_passing" true

    record 3 type "pr"
    attr 3 "pr.number" 7
  }

  when rule "Block PRs with failing tests"

  expect {
    flagged 1
    not flagged 2
    not flagged 3
    did 1 block "pr.merge"
    did 1 comment "pr" contains "failing"
  }
}

test "Fork PR requires a maintainer and names the author" {
  given {
    record 1 type "pr"
    attr 1 "pr.is_fork" true
    attr 1 "pr.author" "outsider"

    record 2 type "pr"
    attr 2 "pr.is_fork" false
    attr 2 "pr.author" "teammate"
  }

  when rule "Fork PRs need a maintainer"

  expect {
    flagged 1
    not flagged 2
    did 1 block "pr.merge"
    did 1 require "review.human"
    did 1 comment "pr" contains "@outsider"
    did_not 2 block "pr.merge"
  }
}

test "Truncated diff asks for a human without blocking" {
  given {
    record 1 type "pr"
    attr 1 "pr.diff_truncated" true

    record 2 type "pr"
    attr 2 "pr.diff_truncated" false
  }

  when rule "Diff too large to review automatically"

  expect {
    flagged 1
    not flagged 2
    did 1 require "review.human"
    did 1 comment "pr" contains "A human must review"
  }
}
